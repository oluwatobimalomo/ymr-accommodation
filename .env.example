# Pooled connection (Neon "pooled" host) - used by the running app
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/ymr?sslmode=require
# Direct connection - used only for migrations
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/ymr?sslmode=require

# Public origin, used for CSRF origin checks and links
APP_ORIGIN=https://accommodation.ymrglobal.org
MAIN_SITE_URL=https://ymrglobal.org

# Only used by `npm run db:seed` to create the first Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Paystack (test mode secret key while developing). Get this from your
# Paystack dashboard > Settings > API Keys & Webhooks. Without this set,
# bookings still work but skip straight to the confirmation page at PENDING.
PAYSTACK_SECRET_KEY=

# Booking confirmation and gift email delivery (Resend)
RESEND_API_KEY=
EMAIL_FROM="YMR 2026 Accommodation <bookings@your-verified-domain.org>"
# Secure the scheduled request to /api/cron/email-outbox with this bearer secret
CRON_SECRET=
